  "captureHtml": "<div class=\"modal dexcard-modal\" style=\"--c: #F7D02C;\"><div class=\"modal-body\"><div class=\"dexcard v2 \">\n      <div class=\"dc-head\"><h2>Pikachu <i class=\"shiny-mk\" role=\"img\" aria-label=\"Shiny\"></i></h2><span class=\"dc-new\">New</span>\n        <div class=\"dc-sum\"><span>No. <b>025</b></span><span>Kanto <b>8</b>/151</span></div></div>\n      <div class=\"dc-top\">\n        <div class=\"dc-hero caught\"><img class=\"dc-ball\" src=\"assets/items/poke-ball.png\" alt=\"Caught\"><div style=\"position: relative; transform-origin: 50% 100%;\"><img class=\"art spr\" src=\"assets/pokemon/art/shiny/25.gif\" alt=\"\" data-b=\"5,0,44,46\" style=\"visibility: hidden; transform-origin: 50% 100%;\" onload=\"pcArtFit(this, 2, 0)\"></div></div>\n        <div class=\"dc-id\">\n          <div class=\"genus\">Mouse Pokémon</div>\n          <div class=\"badges\"><span class=\"type\" data-type=\"electric\" style=\"--tc:#F7D02C;background:var(--tc)\">Electric</span> <span class=\"rarity\" style=\"color:#9aa4b1\"><span class=\"rpips r-common\" style=\"--rc:#9aa4b1\" title=\"Common\"><i></i></span>Common</span></div>\n          <div class=\"dc-facts\">\n            <div class=\"dc-fact\">Level<b>5</b></div>\n            <div class=\"dc-fact\">Height<b>0.4 m</b></div><div class=\"dc-fact\">Weight<b>6 kg</b></div>\n            <div class=\"dc-fact\">Caught<b><img src=\"assets/items/poke-ball.png\" alt=\"\">2</b></div>\n          </div>\n          \n        </div>\n      </div>\n      <p class=\"flavor\">Possesses cheek sacs in which it stores electricity. This clever forest-dweller roasts tough berries with an electric shock before consuming them.</p>\n      \n      \n      \n      \n    </div></div><div class=\"modal-actions solo\"><button class=\"btn gold\">Continue</button></div></div>"
