  "html": "<div class=\"arena\" id=\"arena\" style=\"--hud-bottom: 0px; --tile: 46px; --k: 2; --ks: 2; --kt: 2; background-image: url(&quot;assets/bg/scenes/26-arene-pierre-710x400.webp&quot;);\">\n            <div class=\"ally-slots\" id=\"ally-slots\"><div class=\"ally\" data-uid=\"main-4\" data-team-uid=\"main-4\" style=\"left:30%;bottom:22%;z-index:78\">\n        <div class=\"wrap\" style=\"--sprite-top: calc(0px * var(--k));\"><img alt=\"\" src=\"data:image/png;base64,\" style=\"width: calc(21px * var(--k)); height: calc(19px * var(--k));\">\n          <div class=\"mini-hp\"><div class=\"hp\"><div style=\"width: 78.7879%; background: rgb(240, 96, 122);\"></div></div></div>\n        </div>\n        <div class=\"mini-lv\"><span class=\"lvn\">Lv.11</span></div>\n      </div></div>\n            <div class=\"trainer-slot\" id=\"trainer-slot\"></div>\n            <div class=\"enemy-slot\" id=\"enemy-slot\"><div class=\"enemy\" data-uid=\"brock-74\" style=\"left:78%;bottom:25%;z-index:75\"><div class=\"wrap\" style=\"--sprite-top: calc(0px * var(--k));\"><img alt=\"\" src=\"data:image/png;base64,\" style=\"width: calc(24px * var(--k)); height: calc(15px * var(--k));\"><div class=\"mini-hp\"><div class=\"hp\"><div style=\"width:90.47619047619048%;background:#f0607a\"></div></div></div></div>\n      <div class=\"mini-lv\">Lv.14</div></div></div><canvas class=\"weather-fx\" hidden=\"\"></canvas><div class=\"weather-strike\"></div>\n            <div class=\"enemy-hud\" id=\"enemy-hud\"><div class=\"row\"><b>Leader Brock</b></div>\n      <div class=\"rival-balls\"><img src=\"assets/items/poke-ball.png\" alt=\"\"><img src=\"assets/items/poke-ball.png\" alt=\"\"></div></div>\n            <div class=\"buff-stack\" id=\"buff-stack\" style=\"top: 78px;\"></div>\n            <div class=\"bag-tip buff-tip\" id=\"buff-tip\" role=\"tooltip\" hidden=\"\"></div>\n            <div class=\"scene-bar\" id=\"scene-bar\"><span class=\"sb-pill\" title=\"Day 19:56 · Indoors\"><span data-cond=\"day\">☀️</span><span class=\"sb-clock\">19:56</span><span class=\"sb-sep\"></span><span>🏠</span></span></div>\n            <div class=\"team-rail\" id=\"team-rail\" title=\"Battle send-out order\" style=\"padding-top: 38px;\"><div class=\"tr-row active acting\" data-uid=\"main-4\" data-team-uid=\"main-4\" title=\"Charmander — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/4.png\" alt=\"\" data-id=\"4\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -15px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 11</span><div class=\"tr-hp\"><i style=\"width: 78.7879%; background: rgb(240, 96, 122);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div><div class=\"tr-row ko\" data-uid=\"main-19\" data-team-uid=\"main-19\" title=\"Rattata — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/19.png\" alt=\"\" data-id=\"19\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -14px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 20</span><div class=\"tr-hp\"><i style=\"width: 0%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 100%;\"></i></div>\n        </div><div class=\"tr-row ko\" data-uid=\"main-20\" data-team-uid=\"main-20\" title=\"Raticate — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/20.png\" alt=\"\" data-id=\"20\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -14px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 17</span><div class=\"tr-hp\"><i style=\"width: 0%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div><div class=\"tr-row ko\" data-uid=\"main-74\" data-team-uid=\"main-74\" title=\"Geodude — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/74.png\" alt=\"\" data-id=\"74\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -17px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 16</span><div class=\"tr-hp\"><i style=\"width: 0%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div><div class=\"tr-row ko\" data-uid=\"main-25\" data-team-uid=\"main-25\" title=\"Pikachu — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/25.png\" alt=\"\" data-id=\"25\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -15px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 12</span><div class=\"tr-hp\"><i style=\"width: 0%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div><div class=\"tr-row ko\" data-uid=\"main-8\" data-team-uid=\"main-8\" title=\"Wartortle — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/8.png\" alt=\"\" data-id=\"8\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(-2px, -14px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 10</span><div class=\"tr-hp\"><i style=\"width: 0%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div></div>\n            <div class=\"fx-layer\" id=\"arena-fx\"><canvas width=\"200\" height=\"112\" style=\"position: absolute; inset: 0px; width: 100%; height: 100%; image-rendering: pixelated; pointer-events: none; z-index: 4;\"></canvas><div class=\"fx-tint\" style=\"position: absolute; inset: 0px; opacity: 0; pointer-events: none; z-index: 3; transition: opacity 0.3s linear, background-color 0.3s linear; background: rgb(26, 5, 5);\"></div></div>\n            <div class=\"banner\" id=\"banner\"></div>\n            <div class=\"battle-log\" id=\"battle-log\">Charmander used <b>Fire Spin</b>!</div>\n            <div class=\"adv-controls\">\n              <div class=\"seg\" id=\"speed-btns\"><button data-speed=\"1\" class=\"on\">×1</button><button data-speed=\"2\">×2</button><button data-speed=\"4\">×3</button></div>\n            </div>\n            <div class=\"empty-arena\" id=\"adv-empty\" hidden=\"\"><p>Your team is empty! Pick up to 6 Pokémon from your PC.</p><button class=\"btn gold\">Manage team</button></div>\n          </div>",
