  "html": {
    "#team-rail": "<div class=\"team-rail\" id=\"team-rail\" title=\"Battle send-out order\" style=\"padding-top: 32px;\"><div class=\"tr-row\" data-uid=\"panel-4\" data-team-uid=\"panel-4\" title=\"Charmander — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/4.png\" alt=\"\" data-id=\"4\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -15px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 5</span><div class=\"tr-hp\"><i style=\"width: 100%; background: rgb(240, 96, 122);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div><div class=\"tr-row\" data-uid=\"panel-7\" data-team-uid=\"panel-7\" title=\"Squirtle — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/7.png\" alt=\"\" data-id=\"7\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -16px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 12</span><div class=\"tr-hp\"><i style=\"width: 43.2432%; background: rgb(240, 96, 122);\"></i></div><div class=\"tr-xp\"><i style=\"width: 34.9468%;\"></i></div>\n        </div><div class=\"tr-row active\" data-uid=\"panel-25\" data-team-uid=\"panel-25\" title=\"Pikachu — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/25.png\" alt=\"\" data-id=\"25\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -15px)\"></div><span class=\"tr-st\" style=\"background: rgb(182, 90, 214);\">PSN</span><span class=\"tr-lv\">Lv. 10</span><div class=\"tr-hp\"><i style=\"width: 12.9032%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 80%;\"></i></div>\n        </div><div class=\"tr-row ko\" data-uid=\"panel-16\" data-team-uid=\"panel-16\" title=\"Pidgey — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/16.png\" alt=\"\" data-id=\"16\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -16px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 3</span><div class=\"tr-hp\"><i style=\"width: 0%; background: rgb(214, 51, 79);\"></i></div><div class=\"tr-xp\"><i style=\"width: 0%;\"></i></div>\n        </div><div class=\"tr-row\" data-uid=\"panel-10\" data-team-uid=\"panel-10\" title=\"Caterpie — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/10.png\" alt=\"\" data-id=\"10\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -17px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 7</span><div class=\"tr-hp\"><i style=\"width: 80%; background: rgb(240, 96, 122);\"></i></div><div class=\"tr-xp\"><i style=\"width: 49.8246%;\"></i></div>\n        </div><div class=\"tr-row\" data-uid=\"panel-19\" data-team-uid=\"panel-19\" title=\"Rattata — tap to send it out, drag to reorder\">\n          <div class=\"sprbox \" style=\"height:56px\"><img src=\"assets/pokemon/19.png\" alt=\"\" data-id=\"19\" data-k=\"1\" style=\"width:68px;height:56px;transform:translate(0px, -14px)\"></div><span class=\"tr-st\" hidden=\"\"></span><span class=\"tr-lv\">Lv. 6</span><div class=\"tr-hp\"><i style=\"width: 100%; background: rgb(240, 96, 122);\"></i></div><div class=\"tr-xp\"><i style=\"width: 94.6078%;\"></i></div>\n        </div></div>",
    "#bag-panel": "<div id=\"bag-panel\"><div class=\"zone-box bag-box\">\n      <div class=\"zone-head foldable\" role=\"button\" tabindex=\"0\" aria-expanded=\"true\"><b>Consumables</b><button type=\"button\" class=\"info-tip\" aria-label=\"Info\">i<span class=\"bag-tip info-tip-box\" role=\"tooltip\"><b>Consumables</b><p>The Berries you pick up along the way. Tap one to eat it: its boost lasts 1 h, even offline. Eating the same Berry again adds 1 h (up to 4 h); another one with the same effect replaces it. The rest of your items are in the Bag.</p></span></button><button class=\"btn outline small bag-open\">Bag</button><span class=\"fold\" aria-hidden=\"true\">▾</span></div>\n      <div class=\"bag-grid\"><button class=\"bag-cell berry on\" data-k=\"razz-berry\" aria-label=\"Razz Berry\"><img src=\"assets/items/razz-berry.png\" alt=\"\"><span class=\"bag-timer\">5:55:01</span><span class=\"bag-qty\">×29</span></button><button class=\"bag-cell berry on\" data-k=\"nanab-berry\" aria-label=\"Nanab Berry\"><img src=\"assets/items/nanab-berry.png\" alt=\"\"><span class=\"bag-timer\">55:05</span><span class=\"bag-qty\">×2</span></button><button class=\"bag-cell berry\" data-k=\"pinap-berry\" aria-label=\"Pinap Berry\"><img src=\"assets/items/pinap-berry.png\" alt=\"\"><span class=\"bag-qty\">×1</span></button><button class=\"bag-cell berry\" data-k=\"golden-razz-berry\" aria-label=\"Golden Razz Berry\"><img src=\"assets/items/golden-razz-berry.png\" alt=\"\"><span class=\"bag-qty\">×2</span></button></div>\n      <div class=\"bag-tip\" hidden=\"\"></div></div></div>",
    "#zone-panel": "<div class=\"zone-list\" id=\"zone-panel\"><div class=\"zone-box\">\n      <div class=\"zone-head foldable\" role=\"button\" tabindex=\"0\" aria-expanded=\"true\"><b>Found here</b><button type=\"button\" class=\"info-tip\" aria-label=\"Info\">i<span class=\"bag-tip info-tip-box\" role=\"tooltip\"><b>Found here</b><p>The zone's wild Pokémon: the % is their share of encounters, \"???\" the ones you've never seen. Some only show up at a certain time, weather or day. Your team throws a Poké Ball on its own at every species you're missing.</p></span></button><span class=\"muted\">Route 1</span>\n        <span class=\"zone-count \">1/3</span><span class=\"fold\" aria-hidden=\"true\">▾</span></div>\n      \n      <div class=\"zone-scroll\"><div class=\"zone-grid\"><div class=\"zone-cell caught\" data-id=\"19\" title=\"Rattata · Lv. 2-3 · 45% of encounters\">\n          <div class=\"sprbox \" style=\"height:48px\"><img src=\"assets/pokemon/19.png\" alt=\"\" data-id=\"19\" data-k=\"1.3333333333333333\" style=\"width:90.66666666666666px;height:74.66666666666666px;transform:translate(0px, -18.666666666666664px)\"></div><span class=\"zone-pct\">45%</span></div></div><div class=\"zone-cond now\"><span data-cond=\"day\"><span class=\"zone-cond-ic\">☀️</span>Day</span><span class=\"zone-cond-now\">now</span></div><div class=\"zone-grid\"><div class=\"zone-cell seen\" data-id=\"16\" title=\"Pidgey · Lv. 2-3 · 55% of encounters\">\n          <div class=\"sprbox \" style=\"height:48px\"><img src=\"assets/pokemon/16.png\" alt=\"\" data-id=\"16\" data-k=\"1.5555555555555556\" style=\"width:105.77777777777779px;height:87.11111111111111px;transform:translate(0px, -24.88888888888889px)\"></div><span class=\"zone-pct\">55%</span></div></div><div class=\"zone-cond off\"><span data-cond=\"rain\"><span class=\"zone-cond-ic\">🌧️</span>Rain</span></div><div class=\"zone-grid off\"><div class=\"zone-cell unknown\" data-id=\"7\" title=\"??? · Lv. 2-3 · 6% of encounters\">\n          <div class=\"sprbox \" style=\"height:48px\"><img src=\"assets/pokemon/7.png\" alt=\"\" data-id=\"7\" data-k=\"1.3333333333333333\" style=\"width:90.66666666666666px;height:74.66666666666666px;transform:translate(0px, -21.333333333333332px)\"></div><span class=\"zone-pct\">6%</span></div></div></div></div></div>"
