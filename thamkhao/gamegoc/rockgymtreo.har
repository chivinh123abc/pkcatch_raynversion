              "name": "x-nf-request-id",
              "value": "01M6WNBXXVE4ZG14VMAFJ560HN"
            }
          ],
          "cookies": [],
          "content": {
            "size": 4148,
            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"fr\">\n<head>\n  <!-- The page Netlify serves (tools/bundle.mjs --shell, https://pokecatch-online.pages.dev/ filled in). The game itself (code, styles, images) is on\n       the CDN (Cloudflare Pages, tools/bundle.mjs --cdn): this page only loads its boot.js, so a publish never redeploys\n       it (netlify.toml ignore). The address, and the saves kept by the browser for it, stay the same. -->\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n  <title>Poke'Catch</title>\n  <link rel=\"icon\" href=\"data:image/png;base64,\">\n  <link rel=\"preconnect\" href=\"https://pokecatch-online.pages.dev/\">\n  <link rel=\"preconnect\" href=\"https://qglircqqrtgdvxawisoz.supabase.co\" crossorigin>\n  <style>\n    html, body { margin: 0; background: #12141c; color: #e8ecf4; font-family: system-ui, sans-serif; }\n    html[data-theme=\"light\"], html[data-theme=\"light\"] body { background: #e8ecf4; color: #1b2133; }\n    #boot-fail { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 24px; text-align: center; }\n    #boot-fail button { font: inherit; padding: 10px 20px; border-radius: 10px; border: 0; background: #ffcb05; color: #12141c; font-weight: 700; cursor: pointer; }\n  </style>\n  <script>\n    // The service worker answers the game's images from the CDN (tools/shell/sw.js); boot.js waits a moment for it on a\n    // first visit, so those images don't come from Netlify\n    window.SW_REG = 'serviceWorker' in navigator ? navigator.serviceWorker.register('/sw.js').catch(function () {}) : Promise.resolve();\n    // The CDN can't be reached (or a file of the game is missing): a message and a button to try again, in the player's language\n    window.BOOT_FAIL = function () {\n      if (document.getElementById('boot-fail')) return;\n      var pref = null, nav = (navigator.language || '').slice(0, 2).toLowerCase();\n      try { pref = localStorage.getItem('pokecatch.lang'); } catch (e) { /* storage blocked */ }\n      var LANGS = ['fr', 'en', 'es', 'de', 'zh-Hans', 'zh-Hant', 'ko', 'ja']; // the game's (js/lang-pick.js LANGS, LANGUAGES.md)\n      if (nav === 'zh') nav = /hant|-(tw|hk|mo)\\b/i.test(navigator.language || '') ? 'zh-Hant' : 'zh-Hans';\n      var lang = LANGS.indexOf(pref) >= 0 ? pref : LANGS.indexOf(nav) >= 0 ? nav : 'en';\n      var T = {\n        fr: ['Le jeu n’a pas pu se charger. Vérifie ta connexion puis réessaie.', 'Réessayer'],\n        en: ['The game couldn’t load. Check your connection and try again.', 'Try again'],\n        es: ['No se pudo cargar el juego. Comprueba tu conexión e inténtalo de nuevo.', 'Reintentar'],\n        de: ['Das Spiel konnte nicht geladen werden. Prüf deine Verbindung und versuch es erneut.', 'Erneut versuchen'],\n        'zh-Hans': ['游戏加载失败。请检查网络连接后重试。', '重试'],\n        'zh-Hant': ['遊戲載入失敗。請檢查網路連線後重試。', '重試'],\n        ko: ['게임을 불러오지 못했어요. 인터넷 연결을 확인하고 다시 시도해 주세요.', '다시 시도'],\n        ja: ['ゲームを読み込めませんでした。通信環境を確認して、もう一度お試しください。', '再読み込み'],\n      }[lang];\n      var box = document.createElement('div'), p = document.createElement('p'), b = document.createElement('button');\n      box.id = 'boot-fail'; p.textContent = T[0]; b.textContent = T[1];\n      b.onclick = function () { location.reload(); };\n      box.appendChild(p); box.appendChild(b);\n      (document.body || document.documentElement).appendChild(box);\n    };\n  </script>\n  <script src=\"https://pokecatch-online.pages.dev/boot.js\" onerror=\"BOOT_FAIL()\"></script>\n</head>\n<body>\n</body>\n</html>\n"
          },
