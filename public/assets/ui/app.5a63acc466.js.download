,[15,"baby-doll-eyes"],[20,"swift"],[25,"psybeam"],[30,"morning-sun"],[35,"power-swap"],[40,"psychic"],[45,"psych-up"],[50,"future-sight"],[55,"last-resort"]]},{id:197,name:"Noctali",key:"umbreon",types:["dark"],stats:{hp:95,atk:65,def:110,spa:60,spd:130,spe:65},captureRate:45,legendary:!1,mythical:!1,height:1,weight:27,genus:"Pokémon Lune",flavor:"Les nuits de pleine lune, ou s’il est agité, les anneaux sur sa peau se mettent à briller.",learn:[[0,"snarl"],[5,"sand-attack"],[10,"quick-attack"],[15,"baby-doll-eyes"],[20,"confuse-ray"],[25,"assurance"],[30,"moonlight"],[35,"guard-swap"],[40,"dark-pulse"],[45,"screech"],[50,"mean-look"],[55,"last-resort"]]},{id:198,name:"Cornèbre",key:"murkrow",types:["dark","flying"],stats:{hp:60,atk:85,def:42,spa:85,spd:42,spe:91},captureRate:30,legendary:!1,mythical:!1,height:.5,weight:2.1,genus:"Pokémon Obscurité",flavor:"Il cherche des objets brillants pour son chef. Sa réputation d’oiseau de mauvais augure lui vaut la haine de nombreuses personnes.",learn:[[1,"peck"],[1,"astonish"],[5,"gust"],[11,"haze"],[15,"wing-attack"],[21,"night-shade"],[25,"assurance"],[31,"taunt"],[35,"mean-look"],[40,"foul-play"],[50,"sucker-punch"],[55,"torment"],[60,"quash"]]},{id:199,name:"Roigada",key:"slowking",types:["water","psychic"],stats:{hp:95,atk:75,def:80,spa:100,spd:110,spe:30},captureRate:70,legendary:!1,mythical:!1,height:2,weight:79.5,genus:"Pokémon Royal",flavor:"Il est capable de résoudre tous les problèmes qu’on lui présente, mais personne ne parvient à comprendre ce qu’il dit.",learn:[[9,"yawn"],[12,"confusion"],[15,"disable"],[18,"water-pulse"],[21,"headbutt"],[27,"amnesia"],[30,"surf"],[33,"slack-off"],[36,"psychic"],[39,"psych-up"],[42,"rain-dance"],[45,"heal-pulse"]]},{id:200,name:"Feuforêve",key:"misdreavus",types:["ghost"],stats:{hp:60,atk:60,def:60,spa:85,spd:85,spe:85},captureRate:45,legendary:!1,mythical:!1,height:.7,weight:1,genus:"Pokémon Strident",flavor:"Il adore faire peur aux humains en imitant leurs pleurs, et n’apprécie guère ceux qui ne se laissent pas intimider.",learn:[[1,"growl"],[1,"confusion"],[10,"astonish"],[14,"confuse-ray"],[19,"mean-look"],[23,"hex"],[28,"psybeam"],[32,"pain-split"],[37,"payback"],[41,"shadow-ball"],[46,"perish-song"],[50,"power-gem"]]},{id:201,name:"Zarbi",key:"unown",types:["psychic"],stats:{hp:48,atk:72,def:48,spa:72,spd:48,spe:48},captureRate:225,legendary:!1,mythical:!1,height:.5,weight:5,genus:"Pokémon Symbolique",flavor:"Ce Pokémon a la forme d’un caractère d’écriture antique. Personne ne sait si ces écritures antiques sont apparues avant les Zarbi ou le contraire. Des études sont en cours, mais aucun résultat n’a été annoncé.",learn:[[1,"hidden-power"]]},{id:202,name:"Qulbutoké",key:"wobbuffet",types:["psychic"],stats:{hp:190,atk:33,def:58,spa:33,spd:58,spe:33},captureRate:45,legendary:!1,mythical:!1,height:1.3,weight:28.5,genus:"Pokémon Patient",flavor:"Il vit discrètement dans l’obscurité pour cacher sa queue noire. Il n’attaque jamais en premier.",learn:[[0,"counter"],[0,"destiny-bond"],[0,"safeguard"],[0,"mirror-coat"],[1,"amnesia"],[1,"splash"],[1,"charm"],[1,"encore"]]},{id:203,name:"Girafarig",key:"girafarig",types:["normal","psychic"],stats:{hp:70,atk:80,def:65,spa:90,spd:65,spe:85},captureRate:60,legendary:!1,mythical:!1,height:1.5,weight:41.5,genus:"Pokémon Long-Cou",flavor:"La tête à l’arrière de Girafarig abrite un cerveau trop petit pour penser. En revanche, cette tête arrière n’a pas besoin de dormir, ce qui lui permet de monter la garde tout le temps.",learn:[[1,"tackle"],[1,"growl"],[1,"astonish"],[1,"power-swap"],[1,"guard-swap"],[5,"confusion"],[10,"assurance"],[14,"stomp"],[19,"psybeam"],[23,"agility"],[28,"double-hit"],[32,"twin-beam"],[37,"crunch"],[41,"baton-pass"],[46,"nasty-plot"],[50,"psychic"]]},{id:204,name:"Pomdepik",key:"pineco",types:["bug"],stats:{hp:50,atk:65,def:90,spa:35,spd:35,spe:15},captureRate:190,legendary:!1,mythical:!1,height:.6,weight:7.2,genus:"Pokémon Ver Caché",flavor:"Il grandit en utilisant sa salive pour coller l’écorce des arbres sur son corps. Un Pomdepik âgé peut prendre des proportions démesurées.",learn:[[1,"tackle"],[1,"protect"],[6,"self-destruct"],[9,"bug-bite"],[12,"take-down"],[17,"rapid-spin"],[20,"rollout"],[23,"curse"],[28,"spikes"],[31,"payback"],[34,"explosion"],[39,"iron-defense"],[42,"gyro-ball"],[45,"double-edge"]]},{id:205,name:"Foretress",key:"forretress",types:["bug","steel"],stats:{hp:75,atk:90,def:140,spa:60,spd:60,spe:40},captureRate:75,legendary:!1,mythical:!1,height:1.2,weight:125.8,genus:"Pokémon Ver Caché",flavor:"On ne peut voir l’intérieur de sa carapace que lorsqu’il engloutit sa nourriture, mais il est si rapide que personne n’a encore jamais réussi.",learn:[[0,"heavy-slam"],[12,"take-down"],[17,"rapid-spin"],[20,"rollout"],[23,"curse"],[28,"spikes"],[32,"payback"],[36,"explosion"],[42,"iron-defense"],[46,"gyro-ball"],[50,"double-edge"]]},{id:206,name:"Insolourdo",key:"dunsparce",types:["normal"],stats:{hp:100,atk:70,def:70,spa:65,spd:65,spe:45},captureRate:190,legendary:!1,mythical:!1,height:1.5,weight:14,genus:"Pokémon Serpent",flavor:"Bien que son nid ressemble à un labyrinthe, il ne s’y perd jamais, car il se repère grâce à l’odeur de la terre.",learn:[[1,"defense-curl"],[1,"flail"],[4,"mud-slap"],[8,"rollout"],[12,"glare"],[16,"screech"],[20,"ancient-power"],[24,"drill-run"],[28,"yawn"],[32,"hyper-drill"],[36,"roost"],[40,"dragon-rush"],[44,"coil"],[48,"double-edge"],[52,"endeavor"]]},{id:207,name:"Scorplane",key:"gligar",types:["ground","flying"],stats:{hp:65,atk:75,def:105,spa:35,spd:65,spe:85},captureRate:60,legendary:!1,mythical:!1,height:1.1,weight:64.8,genus:"Pokémon Scorpivol",flavor:"Scorplane plane dans les airs sans un bruit, comme s’il glissait. Ce Pokémon s’accroche au visage de son ennemi grâce aux serres de ses pattes arrière et aux pinces de ses pattes avant, et pique avec son dard empoisonné.",learn:[[1,"poison-sting"],[4,"sand-attack"],[7,"harden"],[10,"knock-off"],[13,"quick-attack"],[16,"fury-cutter"]