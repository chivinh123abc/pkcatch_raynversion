nus:"Pokémon Spirale",flavor:"Ses crocs sont capables de broyer la roche, mais il ne peut s’attaquer qu’aux proies à portée de ses tentacules.",learn:[[0,"crunch"],[15,"water-gun"],[20,"leer"],[25,"mud-shot"],[30,"ancient-power"],[35,"brine"],[43,"protect"],[49,"rock-blast"],[56,"surf"],[63,"shell-smash"],[70,"hydro-pump"]]},{id:140,name:"Kabuto",key:"kabuto",types:["rock","water"],stats:{hp:30,atk:80,def:90,spa:55,spd:45,spe:55},captureRate:45,legendary:!1,mythical:!1,height:.5,weight:11.5,genus:"Pokémon Carapace",flavor:"On raconte qu’ils se seraient éteints, mais apparemment, on peut souvent en croiser dans une zone particulière.",learn:[[1,"absorb"],[1,"harden"],[5,"scratch"],[10,"sand-attack"],[15,"aqua-jet"],[20,"leer"],[25,"mud-shot"],[30,"ancient-power"],[35,"brine"],[41,"protect"],[45,"leech-life"],[50,"liquidation"],[55,"metal-sound"],[60,"stone-edge"]]},{id:141,name:"Kabutops",key:"kabutops",types:["rock","water"],stats:{hp:60,atk:115,def:105,spa:65,spd:70,spe:80},captureRate:45,legendary:!1,mythical:!1,height:1.3,weight:40.5,genus:"Pokémon Carapace",flavor:"Nul ne sait pourquoi il s’est éteint. Ce Pokémon préhistorique féroce vivait dans les mers chaudes.",learn:[[0,"slash"],[15,"aqua-jet"],[20,"leer"],[25,"mud-shot"],[30,"ancient-power"],[35,"brine"],[43,"protect"],[49,"leech-life"],[56,"liquidation"],[63,"metal-sound"],[70,"stone-edge"]]},{id:142,name:"Ptéra",key:"aerodactyl",types:["rock","flying"],stats:{hp:80,atk:105,def:65,spa:60,spd:75,spe:130},captureRate:45,legendary:!1,mythical:!1,height:1.8,weight:59,genus:"Pokémon Fossile",flavor:"Sa dentition semblable à une scie peut même broyer la peau des Pokémon Acier.",learn:[[1,"bite"],[1,"ancient-power"],[5,"supersonic"],[10,"wing-attack"],[15,"scary-face"],[20,"rock-slide"],[25,"roar"],[30,"crunch"],[35,"iron-head"],[40,"take-down"],[45,"stone-edge"],[50,"agility"],[55,"hyper-beam"],[60,"giga-impact"]]},{id:143,name:"Ronflex",key:"snorlax",types:["normal"],stats:{hp:160,atk:110,def:65,spa:65,spd:110,