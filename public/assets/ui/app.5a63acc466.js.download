-dance"],[20,"sunny-day"],[20,"hail"],[25,"weather-ball"],[35,"hydro-pump"],[35,"blizzard"],[35,"fire-blast"],[45,"hurricane"]]},{id:352,name:"Kecleon",key:"kecleon",types:["normal"],stats:{hp:60,atk:90,def:70,spa:60,spd:120,spe:40},captureRate:200,legendary:!1,mythical:!1,height:1,weight:22,genus:"Pokémon Multicolor",flavor:"Sa couleur change quand il se cache, mais varie aussi selon son humeur et son état de santé : plus il est en forme, plus sa couleur est vive.",learn:[[1,"scratch"],[1,"tail-whip"],[1,"lick"],[1,"thief"],[1,"astonish"],[4,"bind"],[7,"shadow-sneak"],[10,"feint"],[13,"fury-swipes"],[16,"disable"],[18,"psybeam"],[21,"ancient-power"],[25,"slash"],[30,"detect"],[33,"shadow-claw"],[38,"screech"],[42,"substitute"],[46,"sucker-punch"],[50,"foul-play"]]},{id:353,name:"Polichombr",key:"shuppet",types:["ghost"],stats:{hp:44,atk:75,def:35,spa:63,spd:33,spe:45},captureRate:225,legendary:!1,mythical:!1,height:.6,weight:2.3,genus:"Pokémon Poupée",flavor:"Il existe un proverbe ancien qui dit : « Fuis la demeure où les Polichombr se rassemblent en nombre à la pénombre. »",learn:[[1,"astonish"],[4,"screech"],[7,"night-shade"],[10,"spite"],[16,"will-o-wisp"],[19,"shadow-sneak"],[22,"hex"],[26,"curse"],[30,"shadow-ball"],[34,"role-play"],[38,"sucker-punch"],[42,"trick"],[48,"phantom-force"]]},{id:354,name:"Branette",key:"banette",types:["ghost"],stats:{hp:64,atk:115,def:65,spa:83,spd:63,spe:65},captureRate:45,legendary:!1,mythical:!1,height:1.1,weight:12.5,genus:"Pokémon Marionnette",flavor:"Il est né de la rancune qu’il a ressentie quand il a été abandonné. Il redevient apparemment une poupée si l’on en prend grand soin.",learn:[[0,"knock-off"],[16,"will-o-wisp"],[19,"shadow-sneak"],[22,"hex"],[26,"curse"],[30,"shadow-ball"],[34,"role-play"],[40,"sucker-punch"],[46,"trick"],[53,"phantom-force"]]},{id:355,name:"Skelénox",key:"duskull",types:["ghost"],stats:{hp:20,atk:40,def:90,spa:30,spd:90,spe:25},captureRate:190,legendary:!1,mythical:!1,height:.8,weight:15,genus:"Pokémon Requiem",flavor:"Ce Pokémon devient invisible pour se rapprocher furtivement de ses proies. Il a le pouvoir de traverser les murs.",learn:[[1,"leer"],[1,"astonish"],[4,"disable"],[8,"shadow-sneak"],[12,"confuse-ray"],[16,"night-shade"],[20,"payback"],[24,"will-o-wisp"],[28,"mean-look"],[32,"hex"],[36,"curse"],[40,"shadow-ball"],[44,"future-sight"]]},{id:356,name:"Téraclope",key:"dusclops",types:["ghost"],stats:{hp:40,atk:70,def:130,spa:60,spd:130,spe:25},captureRate:90,legendary:!1,mythical:!1,height:1.6,weight:30.6,genus:"Pokémon Appel",flavor:"Il cherche des feux follets pour les avaler. Ce qu’il se passe alors à l’intérieur de son corps vide est un mystère.",learn:[[0,"shadow-punch"],[12,"confuse-ray"],[16,"night-shade"],[20,"payback"],[24,"will-o-wisp"],[28,"mean-look"],[32,"hex"],[36,"curse"],[42,"shadow-ball"],[48,"future-sight"]]},{id:357,name:"Tropius",key:"tropius",types:["grass","flying"],stats:{hp:99,atk:68,def:83,spa:72,spd:87,spe:51},captureRate:200,legendary:!1,mythical:!1,height:2,weight:100,genus:"Pokémon Fruit",flavor:"Dans les régions où il fait chaud, on trouve des fermes dédiées à l’élevage de ce Pokémon, très apprécié pour les fruits poussant sur son cou.",learn:[[1,"gust"],[1,"leer"],[1,"growth"],[1,"razor-leaf"],[1,"leaf-storm"],[6,"sweet-scent"],[10,"stomp"],[16,"magical-leaf"],[21,"whirlwind"],[30,"wide-guard"],[36,"air-slash"],[41,"body-slam"],[46,"outrage"],[50,"synthesis"],[56,"solar-beam"]]},{id:358,name:"Éoko",key:"chimecho",types:["psychic"],stats:{hp:75,atk:50,def:80,spa:95,spd:90,spe:65},captureRate:45,legendary:!1,mythical:!1,height:.6,weight:1,genus:"Pokémon Carillon",flavor:"Lorsqu’il y a beaucoup de vent, Éoko pousse des cris, accroché à une branche ou à un auvent par une ventouse placée sur sa tête. Ce Pokémon attrape des Baies avec sa longue queue pour les manger.",learn:[[1,"wrap"],[1,"growl"],[1,"confusion"],[1,"astonish"],[1,"healing-wish"],[13,"yawn"],[16,"stored-power"],[19,"take-down"],[22,"extrasensory"],[27,"he