,"stomping-tantrum"],[31,"bone-rush"],[36,"focus-energy"],[42,"endeavor"],[48,"bonemerang"],[54,"thrash"],[60,"double-edge"]]},{id:106,name:"Kicklee",key:"hitmonlee",types:["fighting"],stats:{hp:50,atk:120,def:53,spa:35,spd:110,spe:87},captureRate:45,legendary:!1,mythical:!1,height:1.5,weight:49.8,genus:"Pokémon Latteur",flavor:"Kicklee peut rétracter et étendre ses jambes à sa guise. La formidable allonge dont il dispose lui permet de frapper des adversaires éloignés.",learn:[[0,"brick-break"],[4,"double-kick"],[8,"low-kick"],[12,"endure"],[16,"sucker-punch"],[21,"wide-guard"],[24,"blaze-kick"],[28,"feint"],[32,"mega-kick"],[36,"close-combat"],[40,"reversal"],[44,"high-jump-kick"],[50,"axe-kick"]]},{id:107,name:"Tygnon",key:"hitmonchan",types:["fighting"],stats:{hp:50,atk:105,def:79,spa:35,spd:110,spe:76},captureRate:45,legendary:!1,mythical:!1,height:1.4,weight:50.2,genus:"Pokémon Puncheur",flavor:"Ses poings fendent l’air, mais il se fatigue au bout de trois minutes à enchaîner les coups.",learn:[[0,"drain-punch"],[4,"mach-punch"],[8,"vacuum-wave"],[12,"detect"],[16,"bullet-punch"],[21,"quick-guard"],[24,"fire-punch"],[24,"ice-punch"],[24,"thunder-punch"],[28,"agility"],[32,"mega-punch"],[36,"close-combat"],[40,"counter"],[44,"focus-punch"]]},{id:108,name:"Excelangue",key:"lickitung",types:["normal"],stats:{hp:90,atk:55,def:75,spa:60,spd:75,spe:30},captureRate:45,legendary:!1,mythical:!1,height:1.2,weight:65.5,genus:"Pokémon Lécheur",flavor:"Excelangue se nourrit essentiellement de Pokémon Insecte. Il lèche ses ennemis avec sa longue langue pour les paralyser, puis les avale tout rond.",learn:[[1,"defense-curl"],[1,"lick"],[6,"rollout"],[12,"supersonic"],[18,"wrap"],[24,"disable"],[30,"stomp"],[36,"knock-off"],[42,"screech"],[48,"slam"],[54,"power-whip"],[60,"belly-drum"]]},{id:109,name:"Smogo",key:"koffing",types:["poison"],stats:{hp:40,atk:65,def:95,spa:60,spd:45,spe:35},captureRate:190,legendary:!1,mythical:!1,height:.6,weight:1,genus:"Pokémon Gaz Mortel",flav