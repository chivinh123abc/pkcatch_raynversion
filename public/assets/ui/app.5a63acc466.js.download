"],[15,"life-dew"],[20,"ice-shard"],[25,"confuse-ray"],[30,"water-pulse"],[35,"brine"],[40,"body-slam"],[45,"ice-beam"],[50,"rain-dance"],[55,"hydro-pump"],[60,"perish-song"],[65,"sheer-cold"]]},{id:132,name:"Métamorph",key:"ditto",types:["normal"],stats:{hp:48,atk:48,def:48,spa:48,spd:48,spe:48},captureRate:35,legendary:!1,mythical:!1,height:.3,weight:4,genus:"Pokémon Morphing",flavor:"Quand il rencontre l’un de ses semblables, il s’agite avec plus de vivacité que d’habitude pour adopter exactement la même forme que lui.",learn:[[1,"transform"]]},{id:133,name:"Évoli",key:"eevee",types:["normal"],stats:{hp:55,atk:55,def:50,spa:45,spd:65,spe:55},captureRate:45,legendary:!1,mythical:!1,height:.3,weight:6.5,genus:"Pokémon Évolutif",flavor:"L’ADN de ce Pokémon très particulier recèle de nombreuses possibilités d’évolution.",learn:[[1,"tackle"],[1,"tail-whip"],[1,"growl"],[1,"helping-hand"],[1,"covet"],[5,"sand-attack"],[10,"quick-attack"],[15,"baby-doll-eyes"],[20,"swift"],[25,"bite"],[30,"copycat"],[35,"baton-pass"],[40,"take-down"],[45,"charm"],[50,"double-edge"],[55,"last-resort"]]},{id:134,name:"Aquali",key:"vaporeon",types:["water"],stats:{hp:130,atk:65,def:60,spa:110,spd:95,spe:65},captureRate:45,legendary:!1,mythical:!1,height:1,weight:29,genus:"Pokémon Bulleur",flavor:"Sa structure cellulaire est similaire à la composition moléculaire de l’eau. Une fois dans cet élément, il devient indétectable à l’œil nu.",learn:[[0,"water-gun"],[5,"sand-attack"],[10,"quick-attack"],[15,"baby-doll-eyes"],[20,"haze"],[25,"water-pulse"],[30,"aurora-beam"],[35,"aqua-ring"],[40,"muddy-water"],[45,"acid-armor"],[50,"hydro-pump"],[55,"last-resort"]]},{id:135,name:"Voltali",key:"jolteon",types:["electric"],stats:{hp:65,atk:65,def:60,spa:110,spd:95,spe:130},captureRate:45,legendary:!1,mythical:!1,height:.8,weight:24.5,genus:"Pokémon Orage",flavor:"Il se charge d’ions négatifs contenus dans l’air pour envoyer des décharges d’environ 10 000 volts.",learn:[[0,"thunder-shock"],[5,"sand-att