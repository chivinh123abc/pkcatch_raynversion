"],[8,"metal-claw"],[12,"counter"],[16,"work-up"],[20,"rock-smash"],[24,"vacuum-wave"],[28,"screech"],[32,"quick-guard"],[36,"force-palm"],[40,"swords-dance"],[44,"helping-hand"],[48,"copycat"],[52,"final-gambit"],[56,"reversal"]],baby:!0},{id:448,name:"Lucario",key:"lucario",types:["fighting","steel"],stats:{hp:70,atk:110,def:70,spa:115,spd:70,spe:90},captureRate:45,legendary:!1,mythical:!1,height:1.2,weight:54,genus:"Pokémon Aura",flavor:"Étant capable de lire ce que pensent les humains, ce Pokémon ne s’attache qu’aux Dresseurs dotés d’un cœur pur.",learn:[[0,"aura-sphere"],[12,"counter"],[16,"work-up"],[20,"force-palm"],[24,"calm-mind"],[28,"metal-sound"],[32,"quick-guard"],[36,"bone-rush"],[40,"swords-dance"],[44,"heal-pulse"],[48,"meteor-mash"],[52,"dragon-pulse"],[56,"extreme-speed"],[60,"close-combat"]]},{id:449,name:"Hippopotas",key:"hippopotas",types:["ground"],stats:{hp:68,atk:72,def:78,spa:38,spd:42,spe:32},captureRate:140,legendary:!1,mythical:!1,height:.8,weight:49.5,genus:"Pokémon Hippo",flavor:"Il est principalement actif pendant la journée. Il s’enfouit profondément dans le sable pour dormir, car les nuits désertiques sont très froides.",learn:[[1,"sand-attack"],[1,"tackle"],[4,"bite"],[8,"yawn"],[12,"sand-tomb"],[16,"dig"],[20,"crunch"],[24,"sandstorm"],[28,"take-down"],[32,"roar"],[36,"rest"],[40,"earthquake"],[44,"double-edge"],[48,"fissure"],[52,"slack-off"]]},{id:450,name:"Hippodocus",key:"hippowdon",types:["ground"],stats:{hp:108,atk:112,def:118,spa:68,spd:72,spe:47},captureRate:60,legendary:!1,mythical:!1,height:2,weight:300,genus:"Pokémon Poids Lourd",flavor:"Il entre dans une violente colère quand on l’énerve : il expulse le sable qu’il a accumulé pour provoquer de véritables tempêtes.",learn:[[12,"sand-tomb"],[16,"dig"],[20,"crunch"],[24,"sandstorm"],[28,"take-down"],[32,"roar"],[38,"rest"],[44,"earthquake"],[50,"double-edge"],[56,"fissure"],[62,"slack-off"]]},{id:451,name:"Rapion",key:"skorupi",types:["poison","bug"],stats:{hp:40,atk:50,de